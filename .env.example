# Copy to .env. Empty values = fake versions run.
PORT=3000
PARALLEL_API_KEY=
COMPOSIO_API_KEY=
# Cline headless: plain API key provider, open model
CLINE_PROVIDER=
CLINE_MODEL=
CLINE_API_KEY=
# Approvals. APPROVAL_TRANSPORT picks one; unset = scripted fake replies.
#   imessage-local  this Mac's Messages app (grant Full Disk Access to the terminal that runs Genie)
#   imessage-cloud  Photon Cloud, needs PHOTON_PROJECT_ID + PHOTON_PROJECT_SECRET
#   slack           needs SLACK_TEAM_ID + SLACK_BOT_TOKEN, OWNER_ADDRESS = channel or user id
APPROVAL_TRANSPORT=
OWNER_PHONE=+15555550123
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
SLACK_TEAM_ID=
SLACK_BOT_TOKEN=
OWNER_ADDRESS=
APPROVAL_RETRIES=8
GITHUB_TOKEN=
ISSUES_URL=https://github.com/genie-wishes/wishes/issues
PAGES_BASE=https://genie-wishes.github.io/wishes
# Vercel: deploy apps/<slug>/ as its own project. Token from vercel.com → Account → Tokens.
# Scope is the team's URL slug (not its team_... id) if deploying under a team, else leave empty.
VERCEL_TOKEN=
VERCEL_SCOPE=
# GitHub org each granted wish gets its own repo under (steps/launch.ts, lib/repo.ts).
GITHUB_ORG=genie-wishes
# Composio user id the Reddit/GitHub connections live under in the Composio dashboard.
COMPOSIO_USER_ID=default
# The GitHub login Genie comments as, so it never reads its own comments as reports.
GITHUB_BOT_LOGIN=
# Pace of the build loop
DISCOVER_EVERY_MS=600000
NO_COOLDOWN_MS=60000
# Fakes
FAKE_DELAY_MS=700
FAKE_REPLIES=yes,yes,yes
# Reports the fake files on its own, on the oldest live app, one every FAKE_REPORT_AFTER_MS.
#   unset  → "Can you add dark mode?" once, but only while approvals are fake too (never texts a real phone by surprise)
#   empty  → never; file reports by hand: curl -X POST 'localhost:3000/report?slug=<app>&author=you' -d 'Can you add dark mode?'
#   a|b    → those, in order
# FAKE_REPORTS=Can you add dark mode?
FAKE_REPORT_AFTER_MS=3000
