# Copy to .env. Empty values = fake versions run.
PORT=3000
PARALLEL_API_KEY=
COMPOSIO_API_KEY=
# Cline headless: plain API key provider, open model
CLINE_PROVIDER=
CLINE_MODEL=
CLINE_API_KEY=
# Photon Spectrum (iMessage). Slack fallback after 9 PM if Photon isn't working.
PHOTON_API_KEY=
OWNER_PHONE=
SLACK_CHANNEL=
GITHUB_TOKEN=
ISSUES_URL=https://github.com/genie-wishes/wishes/issues
PAGES_BASE=https://genie-wishes.github.io/wishes
# Fakes
FAKE_DELAY_MS=700
FAKE_REPLIES=yes,yes
FAKE_REPORT_AFTER_MS=3000
